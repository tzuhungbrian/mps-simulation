{
  "name": "structured-light-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config=playwright.production.config.ts",
    "format": "prettier --write src e2e scripts *.ts *.json *.html README.md docs",
    "format:check": "prettier --check src e2e scripts *.ts *.json *.html README.md docs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
